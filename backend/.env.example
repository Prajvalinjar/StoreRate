# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database URL (Prisma ORM Connection String)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/storeratedb?schema=public"

# JWT Secret for Session Token Signing (Minimum 32 characters recommended for production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

